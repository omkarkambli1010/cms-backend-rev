# cms-backend configuration. Copy to .env (git-ignored). Real environment
# variables override anything in the file.

# Listen address. Loopback by default: the Next.js server is the only caller.
CMS_BACKEND_ADDR=127.0.0.1:8080

# Set to "production" in deployment. Turns on Secure cookies and ignores the
# development bypass whatever it is set to.
APP_ENV=

# The execute-only role (created by cms-website/db/setup.sql). It can call the
# cms.* stored routines and touch no table. Do NOT use the schema owner here.
DATABASE_URL=postgres://sbi_cms_api:CHANGE_ME@localhost:5432/sbi_cms
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=8000

# Signs session tokens. At least 32 characters; same value keeps existing
# sessions valid across the move from Next.js. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CMS_SESSION_SECRET=
CMS_SESSION_TTL_HOURS=12

# Bearer token the marketing site presents to /api/public/*.
CMS_PUBLIC_API_TOKEN=

# Uploads. The default writes into the Next.js app's public folder so the
# dashboard serves them as /uploads/...; in production use a mounted volume.
CMS_MEDIA_DIR=../cms-website/public/uploads
CMS_MEDIA_PUBLIC_PATH=/uploads
CMS_MEDIA_MAX_BYTES=5242880

# Development only: treat every request as an administrator, no account needed.
# Ignored when APP_ENV=production; the dashboard shows a banner while it is on.
CMS_DEV_BYPASS_AUTH=
